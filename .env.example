# Controller
CW_DATABASE_PATH=./data/clusterwatch.db
CW_OFFLINE_TIMEOUT_SECONDS=15
CW_CPU_WARNING_PERCENT=85
CW_MEMORY_WARNING_PERCENT=85
CW_DISK_WARNING_PERCENT=90
CW_TEMPERATURE_WARNING_C=80
CW_HISTORY_RETENTION_DAYS=7

# Agent (use the Jetson's LAN address for remote physical nodes)
CW_CONTROLLER_URL=http://127.0.0.1:8000
CW_SAMPLE_INTERVAL_SECONDS=5
CW_NODE_ID=jetson-main
CW_NODE_LABELS=role=physical,accelerator=jetson
CW_ENABLE_JETSON_TELEMETRY=true
CW_DELIVERY_MAX_ATTEMPTS=4
CW_DELIVERY_RETRY_BASE_SECONDS=0.5
CW_DELIVERY_RETRY_MAX_SECONDS=5
CW_DELIVERY_RETRY_JITTER=0.2
